# i3 config — gruvbox, matching polybar / rofi / login screen
# https://i3wm.org/docs/userguide.html

set $mod Mod4

# ═══════════════════════════════════════════════════════════════ look
# gruvbox dark (same palette as the wallpaper, polybar and the login screen)
set $bg0    #282828
set $bg1    #3c3836
set $bg2    #504945
set $fg     #ebdbb2
set $gray   #928374
set $yellow #d79921
set $aqua   #458588
set $red    #cc241d

font pango:JetBrains Mono Bold 10

# thin borders instead of title bars; no borders/gaps when a window is alone
default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart

gaps inner 8
gaps outer 2
smart_gaps on

#                       border   background text   indicator child_border
client.focused          $yellow  $yellow    $bg0   $fg       $yellow
client.focused_inactive $bg2     $bg2       $fg    $bg2      $bg2
client.unfocused        $bg1     $bg0       $gray  $bg1      $bg1
client.urgent           $red     $red       $fg    $red      $red
client.placeholder      $bg0     $bg0       $fg    $bg0      $bg0
client.background       $bg0

# ═══════════════════════════════════════════════════════════════ autostart
# XDG autostart .desktop files
exec --no-startup-id dex --autostart --environment i3
# lock the screen before suspend (loginctl lock-session to lock manually)
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork --color=282828
exec --no-startup-id nm-applet
exec --no-startup-id ~/.config/polybar/launch.sh
# --no-fehbg: don't let feh rewrite the stowed ~/.fehbg
exec_always --no-startup-id feh --no-fehbg --bg-fill ~/Pictures/Wallpapers/wallpaper.jpg
exec_always --no-startup-id setxkbmap -layout us,hr -option grp:win_space_toggle
exec_always --no-startup-id xinput set-prop "MSFT0001:00 06CB:CE2D Touchpad" "libinput Tapping Enabled" 1

# ═══════════════════════════════════════════════════════════════ window rules
for_window [class="(?i)pavucontrol"]                    floating enable
for_window [class="(?i)blueman-manager"]                floating enable
for_window [class="(?i)nm-connection-editor"]           floating enable
for_window [window_role="pop-up|dialog|task_dialog"]    floating enable
for_window [window_type="dialog"]                       floating enable

# ═══════════════════════════════════════════════════════════════ apps
bindsym $mod+Return exec i3-sensible-terminal
bindsym $mod+d exec "rofi -modi drun,run -show drun"
bindsym $mod+q kill

# ═══════════════════════════════════════════════════════════════ audio / brightness
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10%
bindsym XF86AudioMute        exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute     exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle

bindsym XF86MonBrightnessUp   exec --no-startup-id brightnessctl set +10%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 10%-

# media keys (laptop + buttons on the headphones)
bindsym XF86AudioPlay  exec --no-startup-id playerctl play-pause
bindsym XF86AudioPause exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext  exec --no-startup-id playerctl next
bindsym XF86AudioPrev  exec --no-startup-id playerctl previous
bindsym XF86AudioStop  exec --no-startup-id playerctl stop

# ═══════════════════════════════════════════════════════════════ headphones
# Sony WH-CH720N — prebacivanje između mobitela i laptopa (~/.local/bin/headphones)
set $hp ~/.local/bin/headphones
# spoji / odspoji (odspajanje ih oslobađa za mobitel)
bindsym $mod+b exec --no-startup-id $hp toggle
# glazba (A2DP) <-> poziv s mikrofonom (HFP)
bindsym $mod+Shift+b exec --no-startup-id $hp mic
bindsym $mod+Ctrl+b exec --no-startup-id blueman-manager
# kad mobitel "ukrade" slušalice -> pauziraj; kad se vrate -> zvuk na njih
exec --no-startup-id $hp watch

# ═══════════════════════════════════════════════════════════════ focus / move
set $up l
set $down k
set $left j
set $right semicolon

# move tiling windows via drag & drop on the title bar
tiling_drag modifier titlebar

bindsym $mod+$left  focus left
bindsym $mod+$down  focus down
bindsym $mod+$up    focus up
bindsym $mod+$right focus right
bindsym $mod+Left   focus left
bindsym $mod+Down   focus down
bindsym $mod+Up     focus up
bindsym $mod+Right  focus right

bindsym $mod+Shift+$left  move left
bindsym $mod+Shift+$down  move down
bindsym $mod+Shift+$up    move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left   move left
bindsym $mod+Shift+Down   move down
bindsym $mod+Shift+Up     move up
bindsym $mod+Shift+Right  move right

bindsym $mod+a focus parent

# Prebacuje trenutni workspace na sljedeći monitor
bindsym $mod+Shift+p move workspace to output next

# (Mod4+Space is the keyboard layout toggle, so floating toggle stays off)
# bindsym $mod+Shift+space floating toggle
# bindsym $mod+space focus mode_toggle

# ═══════════════════════════════════════════════════════════════ layout
bindsym $mod+h split h
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle

bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

# ═══════════════════════════════════════════════════════════════ workspaces
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# ═══════════════════════════════════════════════════════════════ resize
mode "resize" {
        bindsym $left   resize shrink width 10 px or 10 ppt
        bindsym $down   resize grow height 10 px or 10 ppt
        bindsym $up     resize shrink height 10 px or 10 ppt
        bindsym $right  resize grow width 10 px or 10 ppt

        bindsym Left    resize shrink width 10 px or 10 ppt
        bindsym Down    resize grow height 10 px or 10 ppt
        bindsym Up      resize shrink height 10 px or 10 ppt
        bindsym Right   resize grow width 10 px or 10 ppt

        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

# ═══════════════════════════════════════════════════════════════ session
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"
