# Read-only copy of Google Calendar via its secret iCal address.
# The URLs are secret, so they are NOT in this repo: one per file in ~/.local/share/vdirsyncer/
# Google: put it in ~/.local/share/vdirsyncer/gcal-url
# (Google Calendar -> Settings -> <your calendar> -> "Secret address in iCal format").
# Synced every 15 min by the packaged systemd timer: systemctl --user enable --now vdirsyncer.timer

[general]
status_path = "~/.local/share/vdirsyncer/status/"

[pair gcal]
a = "gcal_remote"
b = "gcal_local"
collections = null
conflict_resolution = "a wins"
# remote is read-only: undo any local edits instead of failing
partial_sync = "revert"

[storage gcal_remote]
type = "http"
url.fetch = ["command", "sh", "-c", "tr -d ' \n' < ~/.local/share/vdirsyncer/gcal-url"]

[storage gcal_local]
type = "filesystem"
path = "~/.local/share/calendars/google/"
fileext = ".ics"

# FER (university) timetable - secret URL in ~/.local/share/vdirsyncer/fer-url
[pair fer]
a = "fer_remote"
b = "fer_local"
collections = null
conflict_resolution = "a wins"
partial_sync = "revert"

[storage fer_remote]
type = "http"
url.fetch = ["command", "sh", "-c", "tr -d ' \n' < ~/.local/share/vdirsyncer/fer-url"]

[storage fer_local]
type = "filesystem"
path = "~/.local/share/calendars/fer/"
fileext = ".ics"
