configuration {
    modi:                "drun,run";
    show-icons:          true;
    icon-theme:          "Adwaita";
    drun-display-format: "{name}";
    display-drun:        "❯";
    display-run:         "$";
    matching:            "fuzzy";
    sort:                true;
}

/* gruvbox, matching i3 / polybar / zsh / login screen (themes/gruvbox.rasi) */
@theme "gruvbox"
